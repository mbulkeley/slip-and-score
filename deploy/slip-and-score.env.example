# Production environment. Copy to the repo root as `.env` (gitignored).
# Read by systemd's EnvironmentFile= — plain KEY=value, no quotes, no `export`.
#
#   cp deploy/slip-and-score.env.example .env && chmod 600 .env
#
# Generate a secret key (URL-safe, so bash can also source this file):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ceramics.mauriecloud.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ceramics.mauriecloud.com
DJANGO_BEHIND_PROXY=true
DJANGO_TIME_ZONE=Europe/Amsterdam
# DJANGO_LOG_LEVEL=INFO
